
PORT=4000
NODE_ENV=development

# Point this at your own local Postgres database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/knowledgehub_dev"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Nodemailer (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KnowledgeHub <no-reply@knowledgehub.dev>"

# Rate limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"
AUTH_RATE_LIMIT_MAX="10"
